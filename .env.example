# Copia a .env.local (gitignored). Variables PUBLIC_* terminan en el HTML: nunca pongas secretos aquí.

# GA4 Measurement ID (G-XXXXXXXXXX). Vacío = sin analytics.
PUBLIC_GA4_ID=

# Google Ads (opcional). Conversion ID y label del lead. Vacío = no se envía conversión.
PUBLIC_ADS_ID=
PUBLIC_ADS_LEAD_LABEL=

# Endpoint del formulario. Por defecto el PHP incluido (Hostinger).
PUBLIC_FORM_ENDPOINT=/api/lead.php

# --- Solo servidor (PHP). En Hostinger usa lead-config.php FUERA de public_html (ver README). ---
# LEAD_TO=
# LEAD_FROM=
# LEAD_DRY_RUN=1
