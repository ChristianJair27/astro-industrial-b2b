---
import { site } from '../config/site';
import Icon from './Icon.astro';
---

<section id="industrias" class="bg-brand-50 py-16 md:py-24" data-section="industries">
  <div class="container-page">
    <p class="eyebrow">Industrias</p>
    <h2 class="section-title mt-2">Industrias que atendemos</h2>
    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        site.industries.map((i) => (
          <li class="rounded-md bg-white p-6 ring-1 ring-brand-200">
            <Icon name={i.icon} class="size-8 text-accent-700" />
            <h3 class="mt-4 text-lg font-bold text-brand-900">{i.title}</h3>
            <p class="mt-2 text-muted">{i.description}</p>
            <p class="mt-4 border-t border-brand-100 pt-4 text-sm text-ink">
              <span class="font-semibold">Piezas típicas:</span> {i.parts}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
