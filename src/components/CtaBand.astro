---
import { site } from '../config/site';
import { whatsappHref, rfqMailHref } from '../lib/links';
import Icon from './Icon.astro';
---

<section class="bg-accent-700 py-14 text-white" data-section="cta">
  <div class="container-page flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="text-2xl font-bold sm:text-3xl">{site.cta.heading}</h2>
      <p class="mt-2 text-orange-50">{site.cta.sub}</p>
    </div>
    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <a href={rfqMailHref} class="btn bg-white text-brand-900 hover:bg-brand-50">
        <Icon name="mail" class="size-5" /> Enviar plano por correo
      </a>
      <a href={whatsappHref()} target="_blank" rel="noopener" class="btn bg-brand-950 text-white hover:bg-brand-900">
        <Icon name="whatsapp" class="size-5" /> WhatsApp
      </a>
    </div>
  </div>
</section>
