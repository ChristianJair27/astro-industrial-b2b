---
import { site } from '../config/site';
import Icon from './Icon.astro';

const nav = [
  { href: '#capacidades', label: 'Capacidades' },
  { href: '#industrias', label: 'Industrias' },
  { href: '#calidad', label: 'Calidad' },
  { href: '#proceso', label: 'Proceso' },
  { href: '#ubicacion', label: 'Planta' },
];
---

<header class="sticky top-0 z-40 border-b border-brand-800 bg-brand-950/95 text-white backdrop-blur" data-section="header">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight">
      <span class="inline-flex size-8 items-center justify-center rounded-md border-2 border-accent-300 font-mono text-sm text-accent-300" aria-hidden="true">F</span>
      {site.name}
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex gap-6 text-sm font-medium text-brand-200">
        {nav.map((item) => <li><a class="hover:text-white" href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="#rfq" class="btn hidden min-h-10 bg-accent-600 px-4 py-2 text-sm text-white hover:bg-accent-700 sm:inline-flex">
        <Icon name="file" class="size-5" /> Cotizar
      </a>
      <details class="relative md:hidden">
        <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-md text-brand-100 hover:bg-brand-800 [&::-webkit-details-marker]:hidden">
          <Icon name="menu" />
          <span class="sr-only">Abrir menú</span>
        </summary>
        <nav aria-label="Móvil" class="absolute right-0 mt-2 w-60 rounded-md border border-brand-200 bg-white p-2 text-ink shadow-lg">
          <ul>
            {nav.map((item) => <li><a class="block rounded-md px-3 py-3 hover:bg-brand-50" href={item.href}>{item.label}</a></li>)}
            <li><a class="mt-1 block rounded-md bg-accent-600 px-3 py-3 font-semibold text-white" href="#rfq">Solicitar cotización</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Cierra el menú móvil al elegir una sección.
  document.querySelectorAll('header details a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
  );
</script>
