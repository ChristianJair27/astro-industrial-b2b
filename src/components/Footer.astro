---
import { site } from '../config/site';
import { telHref, rfqMailHref } from '../lib/links';

const year = new Date().getFullYear();
---

<footer class="bg-brand-950 py-10 pb-24 text-sm text-brand-200 md:pb-10" data-section="footer">
  <div class="container-page flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div class="space-y-1">
      <p class="font-semibold text-white">{site.legalName}</p>
      <p>{site.address.street}, {site.address.locality}, {site.address.region} {site.address.postalCode}</p>
      <p>© {year}. Todos los derechos reservados.</p>
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      <li><a class="hover:text-white" href={rfqMailHref}>{site.email}</a></li>
      <li><a class="hover:text-white" href={telHref}>{site.phone}</a></li>
      {site.social.map((s) => <li><a class="hover:text-white" href={s.href} rel="noopener" target="_blank">{s.label}</a></li>)}
    </ul>
  </div>
</footer>
