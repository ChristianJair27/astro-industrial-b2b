---
import { site } from '../config/site';
---

<section id="preguntas" class="py-16 md:py-24" data-section="faq">
  <div class="container-page max-w-3xl">
    <h2 class="text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">Preguntas frecuentes</h2>
    <div class="mt-8 divide-y divide-brand-200 rounded-md border border-brand-200">
      {
        site.faq.map((item) => (
          <details class="group p-5 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-brand-900">
              <h3>{item.q}</h3>
              <span aria-hidden="true" class="text-2xl leading-none text-accent-700 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
