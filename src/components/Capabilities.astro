---
import { site } from '../config/site';
import Icon from './Icon.astro';
---

<section id="capacidades" class="py-16 md:py-24" data-section="capabilities">
  <div class="container-page">
    <p class="eyebrow">Capacidades</p>
    <h2 class="section-title mt-2">Procesos, materiales y tolerancias</h2>
    <p class="mt-3 max-w-2xl text-muted">{site.processesIntro}</p>

    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        site.processes.map((p) => (
          <li class="flex flex-col rounded-md border border-brand-200 bg-white p-6">
            <span class="inline-flex size-12 items-center justify-center rounded-md bg-brand-900 text-accent-300">
              <Icon name={p.icon} />
            </span>
            <h3 class="mt-4 text-lg font-bold text-brand-900">{p.title}</h3>
            <p class="mt-2 flex-1 text-muted">{p.description}</p>
            <ul class="mt-4 space-y-1 border-t border-brand-100 pt-4 font-mono text-sm text-brand-800">
              {p.specs.map((s) => <li>› {s}</li>)}
            </ul>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <div>
        <h3 class="text-xl font-bold text-brand-900">Materiales</h3>
        <dl class="mt-4 divide-y divide-brand-100 rounded-md border border-brand-200">
          {
            site.materials.map((m) => (
              <div class="grid gap-1 p-4 sm:grid-cols-[12rem_1fr] sm:gap-4">
                <dt class="font-semibold text-brand-900">{m.group}</dt>
                <dd class="font-mono text-sm text-muted">{m.items}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div>
        <h3 class="text-xl font-bold text-brand-900">Tolerancias y acabados</h3>
        <div class="mt-4 overflow-hidden rounded-md border border-brand-200">
          <table class="w-full text-left">
            <caption class="sr-only">Tolerancias y acabados de referencia</caption>
            <thead class="bg-brand-900 text-sm text-white">
              <tr><th scope="col" class="p-4 font-semibold">Característica</th><th scope="col" class="p-4 text-right font-semibold">Valor</th></tr>
            </thead>
            <tbody class="divide-y divide-brand-100">
              {
                site.tolerances.map((t) => (
                  <tr>
                    <th scope="row" class="p-4 font-medium text-ink">{t.feature}</th>
                    <td class="p-4 text-right font-mono text-sm whitespace-nowrap text-brand-800">{t.value}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-sm text-muted">{site.capabilitiesNote}</p>
      </div>
    </div>
  </div>
</section>
