---
import { site } from '../config/site';
import { whatsappHref, rfqMailHref } from '../lib/links';
import Icon from './Icon.astro';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || '/api/lead.php';
const field =
  'mt-1 block w-full rounded-md border border-brand-300 bg-white px-4 py-3 text-base text-ink placeholder:text-muted focus:border-accent-600 focus:ring-2 focus:ring-accent-300 focus:outline-none';
const label = 'font-medium text-ink';
const opt = 'font-normal text-muted';
---

<section id="rfq" class="bg-brand-50 py-16 md:py-24" data-section="form">
  <div class="container-page grid gap-10 lg:grid-cols-[1fr_2fr]">
    <div>
      <p class="eyebrow">RFQ</p>
      <h2 class="section-title mt-2">{site.form.heading}</h2>
      <p class="mt-3 text-muted">{site.form.sub}</p>
      <ul class="mt-6 space-y-3 text-sm text-ink">
        <li class="flex gap-2"><Icon name="link" class="size-5 shrink-0 text-accent-700" />Comparte los planos (PDF/STEP) con un link de tu nube o portal: no se suben archivos aquí.</li>
        <li class="flex gap-2"><Icon name="shield" class="size-5 shrink-0 text-accent-700" />¿Información confidencial? Marca "Requiero NDA" y te lo enviamos antes de recibir planos.</li>
        <li class="flex gap-2"><Icon name="mail" class="size-5 shrink-0 text-accent-700" /><span>También por correo: <a href={rfqMailHref} class="font-semibold text-brand-900 underline underline-offset-2">{site.email}</a></span></li>
      </ul>
    </div>

    <form id="lead-form" action={endpoint} method="post" class="grid gap-5 rounded-md bg-white p-5 shadow-sm ring-1 ring-brand-200 sm:grid-cols-2 sm:p-8" novalidate>
      <div>
        <label for="f-company" class={label}>Empresa</label>
        <input id="f-company" name="company" type="text" autocomplete="organization" required maxlength="100" class={field} />
      </div>
      <div>
        <label for="f-name" class={label}>Nombre de contacto</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="80" class={field} />
      </div>
      <div>
        <label for="f-email" class={label}>Correo corporativo</label>
        <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="120" class={field} />
      </div>
      <div>
        <label for="f-phone" class={label}>Teléfono / WhatsApp <span class={opt}>(opcional)</span></label>
        <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" pattern="[0-9+()\s\-]{8,20}" class={field} />
      </div>
      <div class="sm:col-span-2">
        <label for="f-part" class={label}>Número de parte / descripción</label>
        <textarea id="f-part" name="part" rows="3" required maxlength="1000" placeholder="Ej. BRK-2210 rev. C, soporte de aluminio, 2 operaciones de fresado" class={field}></textarea>
      </div>
      <div>
        <label for="f-service" class={label}>Material</label>
        <select id="f-service" name="service" class={field}>
          {site.form.materialOptions.map((o) => <option value={o}>{o}</option>)}
        </select>
      </div>
      <div>
        <label for="f-volume" class={label}>Volumen anual estimado</label>
        <select id="f-volume" name="volume" class={field}>
          {site.form.volumeOptions.map((o) => <option value={o}>{o}</option>)}
        </select>
      </div>
      <div class="sm:col-span-2">
        <label for="f-drawings" class={label}>Link a planos <span class={opt}>(opcional: Drive, OneDrive, WeTransfer…)</span></label>
        <input id="f-drawings" name="drawings_url" type="url" inputmode="url" maxlength="500" placeholder="https://" class={field} />
      </div>
      <div class="sm:col-span-2">
        <label for="f-message" class={label}>Notas <span class={opt}>(tolerancias críticas, acabado, fecha requerida)</span></label>
        <textarea id="f-message" name="message" rows="3" maxlength="1500" class={field}></textarea>
      </div>
      <div class="sm:col-span-2">
        <label class="flex items-center gap-3 text-ink">
          <input id="f-nda" name="nda" type="checkbox" value="1" class="size-5 shrink-0 accent-accent-600" />
          Requiero NDA antes de compartir planos
        </label>
      </div>

      <!-- Anti-spam: honeypot (humanos no lo ven) + tiempo mínimo de llenado. -->
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label for="f-website">No llenar este campo</label>
        <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="ts" value="" />
      <input type="hidden" name="source" value="rfq_form" />

      <div class="flex flex-col gap-3 sm:col-span-2 sm:flex-row">
        <button type="submit" class="btn bg-accent-600 text-white hover:bg-accent-700 disabled:opacity-60">
          <Icon name="file" class="size-5" /> Enviar RFQ
        </button>
        <a href={whatsappHref()} target="_blank" rel="noopener" class="btn border border-brand-300 text-brand-900 hover:bg-brand-50">
          <Icon name="whatsapp" class="size-5 text-whatsapp" /> Cotizar por WhatsApp
        </a>
      </div>
      <p class="text-sm text-muted sm:col-span-2">Usamos tus datos solo para responder esta solicitud.</p>
      <p id="form-status" role="status" aria-live="polite" class="hidden rounded-md p-4 text-sm sm:col-span-2"></p>
    </form>
  </div>
</section>

<script define:vars={{ waFallback: whatsappHref() }}>
  window.__waFallback = waFallback;
</script>

<script>
  import { track, trackAdsLead } from '../lib/analytics';

  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  function show(kind: 'ok' | 'error', html: string) {
    if (!status) return;
    status.className = `rounded-md p-4 text-sm sm:col-span-2 ${kind === 'ok' ? 'bg-green-50 text-green-900' : 'bg-red-50 text-red-900'}`;
    status.innerHTML = html;
  }

  if (form) {
    const ts = form.elements.namedItem('ts') as HTMLInputElement;
    ts.value = String(Date.now());

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      button.disabled = true;
      const data = new FormData(form);
      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const json = (await res.json().catch(() => ({}))) as { ok?: boolean };
        if (!res.ok || !json.ok) throw new Error(String(res.status));
        track('generate_lead', {
          service: String(data.get('service') ?? ''),
          volume: String(data.get('volume') ?? ''),
          source: String(data.get('source') ?? ''),
        });
        trackAdsLead();
        form.reset();
        show('ok', '¡Gracias! Recibimos tu RFQ. Un ingeniero de ventas te contactará en 1 día hábil.');
      } catch {
        const wa = (window as unknown as { __waFallback: string }).__waFallback;
        show('error', `No pudimos enviar el formulario. Inténtalo de nuevo o <a class="font-semibold underline" href="${wa}" target="_blank" rel="noopener">escríbenos por WhatsApp</a>.`);
      } finally {
        button.disabled = false;
        ts.value = String(Date.now());
      }
    });
  }
</script>
