---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { whatsappHref } from '../lib/links';
---

<Base title={`Página no encontrada | ${site.name}`} description="La página que buscas no existe." noindex>
  <Header />
  <main id="main" class="container-page py-24 text-center">
    <p class="text-sm font-semibold text-accent-700">Error 404</p>
    <h1 class="mt-2 text-4xl font-bold text-brand-900">Esta página no existe</h1>
    <p class="mt-4 text-muted">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/" class="btn bg-accent-600 text-white hover:bg-accent-700">Ir al inicio</a>
      <a href={whatsappHref()} target="_blank" rel="noopener" class="btn bg-white text-brand-900 ring-1 ring-brand-300 hover:bg-brand-50">Escríbenos por WhatsApp</a>
    </div>
  </main>
  <Footer />
</Base>
