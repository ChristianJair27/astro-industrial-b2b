---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Capabilities from '../components/Capabilities.astro';
import Industries from '../components/Industries.astro';
import Quality from '../components/Quality.astro';
import RfqProcess from '../components/RfqProcess.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Location from '../components/Location.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { businessSchema, faqSchema, websiteSchema } from '../lib/schema';
---

<Base schema={[websiteSchema(), businessSchema(), faqSchema()]}>
  <Header />
  <main id="main">
    <Hero />
    <Stats />
    <Capabilities />
    <Industries />
    <Quality />
    <RfqProcess />
    <Faq />
    <CtaBand />
    <Location />
    <ContactForm />
  </main>
  <Footer />
  <WhatsAppFloat />
</Base>
